#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hrml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <18 19 20 21 22 23 30 31 32 33 34 35 37 38 39 40 41 36 6 7 8 9 10 11>;
            bindings = <&kp>, <&kp>;
        };

        hrmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 36 37 38 39 40 41 24 25 26 27 28 29>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB        &kp Q  &kp W              &kp E             &kp R          &kp T        &kp Y       &kp U            &kp I              &kp O               &kp P     &kp BSPC
&kp LEFT_META  &kp A  &hrml LEFT_META S  &hrml LEFT_ALT D  &hrml LCTRL F  &kp G        &kp H       &hrmr RCTRL J    &hrmr RIGHT_ALT K  &hrmr RIGHT_META L  &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X              &kp C             &kp V          &kp B        &kp N       &kp M            &kp COMMA          &kp DOT             &kp FSLH  &kp RIGHT_SHIFT
                                         &lt 3 TAB         &lt 1 ESCAPE   &kp SPACE    &kp RETURN  &lt 2 BACKSPACE  &kp RIGHT_SHIFT
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans  &trans  &kp LG(N8)  &kp LG(N6)  &trans       &trans           &kp LG(N7)  &kp LG(N2)  &kp LG(N1)  &kp LG(N5)  &trans  &trans
&trans  &trans  &trans      &trans      &trans       &kp PAGE_UP      &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans  &trans
&trans  &trans  &trans      &trans      &kp LA(TAB)  &kp PAGE_DOWN    &kp LG(N3)  &kp LG(N4)  &kp LG(N9)  &trans      &trans  &trans
                            &trans      &trans       &trans           &trans      &trans      &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp TAB  &kp EXCL        &kp ASTERISK  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE            &kp SLASH   &kp N7  &kp N8  &kp N9  &kp ASTERISK  &trans
&trans   &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN       &kp PERIOD  &kp N4  &kp N5  &kp N6  &kp MINUS     &trans
&trans   &kp UNDERSCORE  &kp EQUAL     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GREATER_THAN    &kp N0      &kp N1  &kp N2  &kp N3  &kp PLUS      &trans
                                       &trans                &trans                 &trans              &trans      &trans  &trans
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans  &trans     &trans  &trans
                                        &trans        &trans        &trans          &trans    &trans    &trans
            >;
        };
    };
};
